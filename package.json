{
  "name": "green-envelope",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:edge": "pnpm --filter edge dev",
    "build": "pnpm --filter web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:spends": "cargo run --quiet --release --manifest-path tools/vectors/Cargo.toml -- verify packages/chia/src/spend-cases.json && cargo run --quiet --release --manifest-path tools/vectors/Cargo.toml -- verify packages/envelope/spend-cases.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e:testnet": "vitest run --config vitest.e2e.config.ts testnet",
    "e2e:handoff": "vitest run --config vitest.e2e.config.ts handoff"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
