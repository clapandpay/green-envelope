{
  "name": "green-envelope",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:edge": "pnpm --filter edge dev",
    "build": "pnpm --filter web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:spends": "cargo run --quiet --release --manifest-path tools/vectors/Cargo.toml -- verify",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/preact": "^3.2.4",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.1",
    "happy-dom": "^20.14.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
