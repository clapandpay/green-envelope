# Green Envelope: the runtime settings of the image (ghcr.io/clapandpay/green-envelope/green-envelope).
# Every one is optional: with none, the image starts on mainnet with the public Coinset node on
# port 80 (and 8787). In ONCE, enter them in the app's settings; with docker, `--env-file`.
# Values here are for envelope.clapandpay.com; replace the keys, never commit real ones.

# mainnet or testnet11. A testnet site also needs the testnet image (tag latest-testnet).
NETWORK=mainnet

# The site's address: link previews, and the only origin the server's API answers in a browser.
# Unset: ONCE's BASE_URL, else the address of each request.
PUBLIC_ORIGIN=https://envelope.clapandpay.com

# The chain node the browser calls. The key is a nodexch *publishable* key (nxp_), allowed only
# from PUBLIC_ORIGIN: every visitor can read it. Unset: the public Coinset node.
PUBLIC_CHAIN_ENDPOINTS=https://api.nodexch.com
PUBLIC_CHAIN_API_KEY=nxp_REPLACE

# The chain node the server uses (link previews, the /api/rpc proxy). The key is a nodexch
# *secret* key (nxs_); it stays on the server. Unset: the public Coinset node.
CHAIN_ENDPOINTS=https://api.nodexch.com
CHAIN_API_KEY=nxs_REPLACE

# Optional: the recipient pick for pasted text and the lookalike-@name warning. Unset: both off.
TYPESAFE_API_KEY=

# Leave unset: the server then listens on 80 (what ONCE expects) and 8787. Set, only that port.
# PORT=

# Not set here: the faucet behind /hello is built into the image (repository variable FAUCET_URL).
# ONCE's own variables (BASE_URL, SECRET_KEY_BASE, DISABLE_SSL, …) are set by ONCE itself.
