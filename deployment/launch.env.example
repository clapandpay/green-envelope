# Copy to .env next to compose.yaml. Nothing here is a secret except TYPESAFE_API_KEY, and .env
# is not committed.

# Mainnet is real money. Use testnet11 only to rehearse.
NETWORK=mainnet

# Your node, then the public fallback is used automatically. Comma-separated, e.g. nodexch first.
CHAIN_ENDPOINTS=

# Optional: lets the two "which address did you mean" screens ask a language model. Empty means
# those screens say nothing, which is the safe answer.
TYPESAFE_API_KEY=

# Pin a release instead of :latest, e.g. green-envelope-v0.1.0 and clapandpay-web-v0.1.0.
ENVELOPE_TAG=latest
SITE_TAG=latest
