# The front of the launch: Caddy gets and renews the certificates by itself and sends each host
# to its container (compose.yaml). Point DNS for all three names at the machine first.
#
#   clapandpay.com            the hub, the Klimper download redirect and the Apple/Android domain files
#   www.clapandpay.com        the same, under one name
#   envelope.clapandpay.com   Green Envelope: /hello, /g/*, /new, /connect, /api/*, /og/*

www.clapandpay.com {
	redir https://clapandpay.com{uri} permanent
}

clapandpay.com {
	encode zstd gzip
	reverse_proxy site:8080
}

envelope.clapandpay.com {
	encode zstd gzip

	# The faucet is its own service when it exists (docs/faucet.md): uncomment and point it at
	# yours. Everything else under /api/ is the app's own handler.
	# handle /api/faucet {
	# 	reverse_proxy faucet:8000
	# }

	reverse_proxy envelope:8787
}
