# Rendered to /etc/nginx/conf.d/default.conf when the container starts (the nginx image's
# entrypoint runs envsubst over /etc/nginx/templates). Only variables that exist in the
# environment are substituted, so nginx's own $uri and friends are left alone. The one value:
# KLIMPER_DOWNLOAD_URL, where /klimper sends people (deployment/launch.env.example).
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  # Caddy terminates TLS in front: a relative redirect must stay relative, or nginx would make it
  # http://<host>:8080/... from its own listen port.
  absolute_redirect off;

  # No cookies, no third parties: the policy says so and the browser enforces it.
  include /etc/nginx/security-headers.conf;

  gzip on;
  gzip_types text/html text/css application/javascript image/svg+xml application/json;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # What Apple and Android read to tie the Klimper app to clapandpay.com: passkeys
  # (webcredentials) and universal links. The files have no extension, so the type is set here, and
  # they must be answered directly, never redirected.
  location /.well-known/ {
    default_type application/json;
    add_header Cache-Control "public, max-age=3600" always;
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
  }

  # The Klimper download: the TestFlight public link today, the App Store link once the listing
  # is live. Set in the deployment's .env, no new image needed; unset, it lands on the Klimper
  # section of the page (the Dockerfile's default).
  location = /klimper {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/security-headers.conf;
    return 302 ${KLIMPER_DOWNLOAD_URL};
  }

  # Where a phone without Klimper lands when a website opens an Xchonnect link. With the app
  # installed iOS hands these URLs to Klimper (apple-app-site-association above) and the page
  # is never fetched. The pairing parameters are in the fragment: the browser never sends them,
  # and the page makes no requests (pair.html).
  location ~ ^/(pair|req)$ {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/security-headers.conf;
    try_files /pair.html =404;
  }

  # The answer of "Use my Clap and Pay money" (TASK-129). With Klimper installed the phone hands
  # it to the app (apple-app-site-association) and this is never fetched; the page says what to
  # do without it. The sealed answer is in the fragment, never sent.
  location = /klimper/return {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/security-headers.conf;
    try_files /klimper-return.html =404;
  }

  location / {
    # The page is one file that changes with a release: let a browser keep it, but ask each time.
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ =404;
  }
}
