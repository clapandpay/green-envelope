# Loaded by Vite in `pnpm dev` only, never in a build.
#
# Development uses the real services, the real keystore and a real chain — the same code the
# released app runs. Only the chain differs: testnet11, so a mistake while building costs
# nothing. Point it at mainnet with `?net=main` in the address bar when you mean to.
VITE_NETWORK=testnet11
